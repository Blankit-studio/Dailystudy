# Supabase project settings → API
# https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# ── Daily AI content generation (optional) ──────────────────────────
# Free Google Gemini API key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional model override (default: gemini-2.5-flash; lighter: gemini-2.5-flash-lite)
# GEMINI_MODEL=gemini-2.5-flash

# Supabase service-role key — server-only, lets the cron job insert content.
# Project Settings → API → service_role (secret). NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Protects the /api/cron/generate endpoint. Set the same value in Vercel;
# Vercel Cron sends it automatically as the Authorization header.
CRON_SECRET=a-long-random-string
